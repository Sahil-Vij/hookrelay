PORT=4000
DATABASE_PATH=hookrelay.db
# JSON map of source name to signing secret
HOOKRELAY_SECRETS={"demo":"change-me"}
# Optional JSON map of source name to the URL its events are forwarded to
HOOKRELAY_TARGETS={"demo":"http://localhost:5000/webhook"}
# Bearer token for the events API. Generate your own with: openssl rand -hex 32
HOOKRELAY_API_KEY=change-me-too
